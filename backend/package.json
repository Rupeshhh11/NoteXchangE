{
    "name": "notexchange-backend",
    "version": "1.0.0",
    "description": "NoteXchangE - Academic Marketplace Backend",
    "main": "dist/index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true nodemon src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "node -r ts-node/register src/database/migrations.ts",
        "seed": "node -r ts-node/register src/database/seed.ts",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "marketplace",
        "academic",
        "students"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "*",
        "bcryptjs": "*",
        "cors": "*",
        "dotenv": "*",
        "express": "*",
        "express-rate-limit": "*",
        "helmet": "*",
        "joi": "*",
        "jsonwebtoken": "*",
        "morgan": "*",
        "multer": "*",
        "nodemailer": "*",
        "pg": "*",
        "razorpay": "*",
        "redis": "*",
        "sequelize": "*",
        "socket.io": "*",
        "typescript": "*"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2"
    }
}
