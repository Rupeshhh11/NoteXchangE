{
    "name": "notexchange-backend",
    "version": "1.0.0",
    "description": "NoteXchangE - Academic Marketplace Backend",
    "main": "dist/index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "node -r ts-node/register src/database/migrations.ts",
        "seed": "node -r ts-node/register src/database/seed.ts",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "marketplace",
        "academic",
        "students"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "typescript": "^5.0.0",
        "dotenv": "^16.3.1",
        "pg": "^8.11.3",
        "sequelize": "^6.35.2",
        "jsonwebtoken": "^9.1.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "joi": "^17.11.0",
        "multer": "^1.4.5-lts.1",
        "razorpay": "^2.9.2",
        "nodemailer": "^6.9.7",
        "socket.io": "^4.7.2",
        "redis": "^4.6.13",
        "morgan": "^1.10.0",
        "express-rate-limit": "^7.1.5",
        "axios": "^1.6.5"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.7",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "prettier": "^3.1.1",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "cross-env": "^7.0.3"
    }
}